# Local Neo4j Desktop database
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-local-neo4j-password
NEO4J_DATABASE=neo4j

# Partition-retrieval artifacts bundled with this checkout
SUBG_DIR=data/Partitions

# Local grounded-answer generation service
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# For Neo4j Aura, use the values from the Aura connection details:
# NEO4J_URI=neo4j+s://<database-id>.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your-aura-password
# NEO4J_DATABASE=neo4j
